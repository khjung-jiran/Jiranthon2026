{% extends 'base.html.twig' %}

{% block title %}이음 · 앨범{% endblock %}

{% block content %}
<main class="app app--status{% if is_parent %} app--parent{% endif %}">
  <div class="album">

    <header class="album__head">
      <div>
        <div class="album__kicker">함께 모은 순간들</div>
        <h1 class="album__title">앨범</h1>
      </div>
      <button type="button" class="album__upload" onclick="openUploadModal()">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
        사진 올리기
      </button>
    </header>

    <div class="album__body">
      <div class="album__grid" id="albumGrid">
        <!-- 데이터 로드 후 JS로 채움 -->
      </div>
    </div>

  </div>

  <!-- 사진 업로드 모달 -->
  <div id="uploadModal" class="modal">
    <div class="modal__body">
      <div class="modal__head">
        <h2 class="modal__title">사진 올리기</h2>
        <button type="button" class="modal__close" onclick="closeUploadModal()">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#5C544A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
      </div>

      <!-- 사진 미리보기 -->
      <div id="uploadPreview" class="modal__preview">
        <img id="previewImg" />
      </div>

      <!-- 파일 선택 버튼 -->
      <input type="file" id="photoFile" accept="image/*" class="is-hidden" onchange="onFileSelected(event)" />
      <button type="button" onclick="document.getElementById('photoFile').click()" id="selectBtn" class="modal__select-btn">
        사진 선택하기
      </button>

      <!-- 라벨 입력 -->
      <div class="modal__field">
        <label class="modal__field-label">사진 제목</label>
        <input type="text" id="photoLabel" placeholder="예) 1982년 봄, 창경원 나들이" class="modal__input" />
      </div>

      <!-- 누가 올렸는지 -->
      <div class="modal__field modal__field--last">
        <label class="modal__field-label">올린 사람</label>
        <input type="text" id="photoWho" placeholder="예) 지훈" class="modal__input" />
      </div>

      <!-- 업로드 버튼 -->
      <button type="button" onclick="uploadPhoto()" id="uploadBtn" class="modal__submit-btn" disabled>
        올리기
      </button>
    </div>
  </div>

  <!-- 사진 상세 모달 -->
  <div id="photoModal" class="modal">
    <div class="modal__body">
      <div class="modal__head">
        <h2 class="modal__title">사진</h2>
        <button type="button" class="modal__close" onclick="closePhotoModal()">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#5C544A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
      </div>
      <div id="photoModalBody"></div>
    </div>
  </div>

  <!-- 하단 탭바 (앨범 활성) -->
  <nav class="tabbar">
    <a class="tabbar__item" href="/story-child">
      <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
      <span class="tabbar__label">이야기</span>
    </a>
    <a class="tabbar__item tabbar__item--on" href="/album">
      <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
      <span class="tabbar__label tabbar__label--on">앨범</span>
    </a>
    <a class="tabbar__item" href="/home">
      <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h5v-6h4v6h5V9.5"/></svg>
      <span class="tabbar__label">홈</span>
    </a>
    <a class="tabbar__item" href="/calendar">
      <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 10h18M8 2v4M16 2v4"/></svg>
      <span class="tabbar__label">캘린더</span>
    </a>
    <a class="tabbar__item" href="/settings">
      <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6"/></svg>
      <span class="tabbar__label">설정</span>
    </a>
  </nav>

</main>
{% endblock %}

{% block scripts %}
<script>
  var authData = null;
  var selectedFile = null;

  (function checkAuth() {
    var auth = localStorage.getItem('eum_auth') || sessionStorage.getItem('eum_auth');
    if (!auth) { window.location.href = '/login'; return; }
    try {
      authData = JSON.parse(auth);
      loadPhotos();
    } catch (e) {}
  })();

  // ── 사진 로드 ──
  async function loadPhotos() {
    if (!authData || !authData.family) return;
    try {
      var res = await fetch('/api/album?family_id=' + encodeURIComponent(authData.family.id));
      if (!res.ok) return;
      var photos = await res.json();
      renderPhotos(photos);
    } catch (e) {}
  }

  function renderPhotos(photos) {
    var grid = document.getElementById('albumGrid');
    if (!photos || photos.length === 0) {
      grid.innerHTML = '<div class="empty-state empty-state--lg empty-state--grid">아직 올린 사진이 없어요.<br>첫 사진을 올려보세요!</div>';
      return;
    }
    var html = '';
    photos.forEach(function(p) {
      var label = p.label || '제목 없음';
      var who = p.who || '';
      var date = p.created_at ? p.created_at.substring(0, 10) : '';
      html += '<div class="photo-tile" onclick="showPhoto(\'' + p.id + '\')">';
      html += '<img src="' + p.url + '" onerror="this.style.background=\'rgba(0,0,0,0.05)\'" />';
      html += '<div class="photo-tile__caption">';
      html += '<div class="photo-tile__title">' + escapeHtml(label) + '</div>';
      if (who) html += '<div class="photo-tile__sub">' + escapeHtml(who) + ' · ' + date + '</div>';
      html += '</div>';
      html += '</div>';
    });
    grid.innerHTML = html;
  }

  function escapeHtml(s) {
    var d = document.createElement('div');
    d.textContent = s;
    return d.innerHTML;
  }

  // ── 사진 상세 ──
  var photoCache = [];
  function showPhoto(photoId) {
    fetch('/api/album?family_id=' + encodeURIComponent(authData.family.id))
      .then(function(r) { return r.json(); })
      .then(function(photos) {
        photoCache = photos;
        var p = photos.find(function(x) { return x.id === photoId; });
        if (!p) return;
        var body = document.getElementById('photoModalBody');
        var label = p.label || '제목 없음';
        var who = p.who || '알 수 없음';
        var date = p.created_at ? p.created_at.substring(0, 10) : '';
        var html = '';
        html += '<div class="photo-detail__img-wrap">';
        html += '<img src="' + p.url + '" class="photo-detail__img" onerror="this.style.display=\'none\'" />';
        html += '</div>';
        html += '<div class="photo-detail__title">' + escapeHtml(label) + '</div>';
        html += '<div class="photo-detail__meta">' + escapeHtml(who) + ' · ' + date + '</div>';
        html += '<button type="button" class="modal__danger-btn" onclick="deletePhoto(\'' + p.id + '\')">삭제하기</button>';
        body.innerHTML = html;
        document.getElementById('photoModal').style.display = 'flex';
      });
  }

  function closePhotoModal() {
    document.getElementById('photoModal').style.display = 'none';
  }

  async function deletePhoto(photoId) {
    if (!confirm('이 사진을 삭제할까요?')) return;
    try {
      var res = await fetch('/api/album/' + photoId + '?member_id=' + encodeURIComponent(authData.member.id), { method: 'DELETE' });
      if (!res.ok) throw new Error('삭제 권한이 없습니다');
      closePhotoModal();
      loadPhotos();
    } catch (e) { alert(e.message || '삭제하지 못했어요'); }
  }

  // ── 업로드 모달 ──
  function openUploadModal() {
    document.getElementById('uploadModal').style.display = 'flex';
    resetUploadForm();
  }

  function closeUploadModal() {
    document.getElementById('uploadModal').style.display = 'none';
    resetUploadForm();
  }

  function resetUploadForm() {
    selectedFile = null;
    document.getElementById('photoFile').value = '';
    document.getElementById('photoLabel').value = '';
    document.getElementById('photoWho').value = '';
    document.getElementById('uploadPreview').style.display = 'none';
    document.getElementById('uploadBtn').disabled = true;
    document.getElementById('uploadBtn').style.opacity = '0.5';
    document.getElementById('selectBtn').textContent = '사진 선택하기';
  }

  function onFileSelected(event) {
    var file = event.target.files[0];
    if (!file) return;
    selectedFile = file;
    // 미리보기
    var reader = new FileReader();
    reader.onload = function(e) {
      document.getElementById('previewImg').src = e.target.result;
      document.getElementById('uploadPreview').style.display = 'block';
    };
    reader.readAsDataURL(file);
    // 파일명에서 확장자 제거한 이름을 기본 라벨로
    var baseName = file.name.replace(/\.[^/.]+$/, '');
    if (!document.getElementById('photoLabel').value) {
      document.getElementById('photoLabel').value = baseName;
    }
    // 업로드 버튼 활성화
    document.getElementById('uploadBtn').disabled = false;
    document.getElementById('uploadBtn').style.opacity = '1';
    document.getElementById('selectBtn').textContent = '다시 선택하기';
    // 올린 사람 기본값 (로그인한 사용자 이름)
    if (!document.getElementById('photoWho').value && authData && authData.member) {
      document.getElementById('photoWho').value = authData.member.name || '';
    }
  }

  async function uploadPhoto() {
    if (!selectedFile) return;
    var btn = document.getElementById('uploadBtn');
    btn.disabled = true;
    btn.textContent = '올리는 중…';

    var formData = new FormData();
    formData.append('file', selectedFile);
    formData.append('family_id', authData.family.id);
    formData.append('label', document.getElementById('photoLabel').value || '');
    formData.append('who', document.getElementById('photoWho').value || '');
    if (authData.member) {
      formData.append('uploaded_by', authData.member.id || '');
    }

    try {
      var res = await fetch('/api/uploads/image', {
        method: 'POST',
        body: formData,
      });
      if (!res.ok) {
        var err = await res.json().catch(function() { return {}; });
        alert(err.detail || '업로드에 실패했어요');
        btn.disabled = false;
        btn.textContent = '올리기';
        return;
      }
      closeUploadModal();
      loadPhotos();
    } catch (e) {
      alert('업로드 중 오류가 발생했어요');
      btn.disabled = false;
      btn.textContent = '올리기';
    }
  }
</script>
{% endblock %}
