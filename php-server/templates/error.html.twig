{% extends 'base.html.twig' %}

{% block title %}이음 — 오류{% endblock %}

{% block content %}
<div class="error-page">
  <h1 class="error-page__code">{{ status_code|default(500) }}</h1>
  <p class="error-page__msg">{{ message|default('서버 오류가 발생했습니다.') }}</p>
  <a href="/" class="error-page__link">← 홈으로 돌아가기</a>
</div>
{% endblock %}
