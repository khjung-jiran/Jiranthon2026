{% extends 'base.html.twig' %}

{% block title %}이음 — 오류{% endblock %}

{% block content %}
<div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; text-align: center; padding: 80px 20px;">
  <h1 style="font-size: 3rem; color: #e53935; margin-bottom: 8px;">{{ status_code|default(500) }}</h1>
  <p style="font-size: 1.2rem; color: #555; margin-bottom: 24px;">{{ message|default('서버 오류가 발생했습니다.') }}</p>
  <a href="/" style="color: #1976d2; text-decoration: none; font-weight: 600;">← 홈으로 돌아가기</a>
</div>
{% endblock %}
