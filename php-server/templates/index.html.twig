{% extends 'base.html.twig' %}

{% block title %}이음{% endblock %}

{% block content %}
<main class="app loading-page">
  <p class="loading-page__text">로딩 중…</p>
</main>
{% endblock %}

{% block scripts %}
<script>
  (function () {
    var auth = localStorage.getItem('eum_auth') || sessionStorage.getItem('eum_auth');
    window.location.replace(auth ? '/home' : '/login');
  })();
</script>
{% endblock %}
