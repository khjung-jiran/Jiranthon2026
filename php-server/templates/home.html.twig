{% extends 'base.html.twig' %}

{% block title %}이음 — 서버 상태{% endblock %}

{% block content %}
<div class="info-page">
  <h1 class="info-page__title">이음 API 서버</h1>
  <p class="info-page__sub">Slim Framework + Twig + PHP {{ php_version }}</p>

  <div class="info-page__card">
    <h2 class="info-page__card-title">서비스 정보</h2>
    <dl class="info-page__dl">
      <dt class="info-page__dt">서비스명</dt><dd class="info-page__dd">{{ service_name }}</dd>
      <dt class="info-page__dt">프레임워크</dt><dd class="info-page__dd">Slim 4 + Twig 3</dd>
      <dt class="info-page__dt">서버 포트</dt><dd class="info-page__dd">:{{ server_port }}</dd>
      <dt class="info-page__dt">DB</dt><dd class="info-page__dd">SQLite ({{ db_path }})</dd>
    </dl>
  </div>

  <div class="info-page__card info-page__card--green">
    <h2 class="info-page__card-title">API 엔드포인트</h2>
    <p class="info-page__note">모든 API는 <code class="info-page__code">/api</code> 경로 하위에서 동작합니다.</p>
    <ul class="info-page__list">
      <li><a href="/api" class="info-page__link">GET /api</a> — 서비스 정보 (JSON)</li>
      <li><strong>가족:</strong> /api/families, /api/families/{id}, /api/families/join</li>
      <li><strong>멤버:</strong> /api/members, /api/auth/login</li>
      <li><strong>질문:</strong> /api/questions, /api/questions/ai-suggestions</li>
      <li><strong>답변:</strong> /api/responses, /api/responses/stats</li>
      <li><strong>스토리북:</strong> /api/storybook</li>
      <li><strong>캡슐:</strong> /api/capsules, /api/capsules/ready</li>
      <li><strong>캘린더:</strong> /api/calendar/entries</li>
      <li><strong>앨범:</strong> /api/album</li>
      <li><strong>알림:</strong> /api/notifications</li>
      <li><strong>투표:</strong> /api/polls</li>
      <li><strong>설정:</strong> /api/settings</li>
      <li><strong>음성:</strong> /api/stt/transcribe, /api/tts/synthesize</li>
    </ul>
  </div>

{% endblock %}
