{% extends 'base.html.twig' %}

{% block title %}이음 · 처리 중{% endblock %}

{% block content %}
<!-- 화면: 처리 중 (음성 답변 → 글 변환) -->
<main class="app proc">

  <div class="proc__orb">
    <div class="proc__orb-glow"></div>
    <svg width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="#E4643E" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19l7-7 3 3-7 7-3-3z"/><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/><path d="M2 2l7.586 7.586"/><circle cx="11" cy="11" r="2"/></svg>
  </div>

  <h1 class="proc__title">오늘의 이야기를<br>정리하고 있어요</h1>

  <div class="proc__dots">
    <span class="proc__dot"></span>
    <span class="proc__dot"></span>
    <span class="proc__dot"></span>
  </div>

  <div class="proc__line" id="procLine">어머니의 목소리를 글로 옮기고 있어요…</div>

  <div class="privacy-pill proc__privacy">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#2E5B4C" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
    <span class="privacy-pill__text">목소리와 기억은 기기 안에서만 처리돼요</span>
  </div>

</main>
{% endblock %}

{% block scripts %}
<script>
  var lines = [
    '어머니의 목소리를 글로 옮기고 있어요…',
    '"새벽 다섯 시, 하얀 와이셔츠를 입고…"',
    '문장을 다듬고 있어요…',
    '대표 문장을 고르고 있어요…'
  ];
  var idx = 0;
  setInterval(function() {
    idx = (idx + 1) % lines.length;
    document.getElementById('procLine').textContent = lines[idx];
  }, 900);

  setTimeout(function() {
    window.location.href = '/story-child';
  }, 3400);
</script>
{% endblock %}
