{% extends 'base.html.twig' %}

{% block title %}이음 — {{ is_parent ? '부모님으로 시작' : '자녀로 시작' }}{% endblock %}

{% block head %}
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700;800&display=swap" rel="stylesheet" />
<style>
  .auth-root {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    font-family: 'Noto Sans KR', -apple-system, sans-serif;
  }

  /* ── 헤더 (뒤로가기) ── */
  .auth-header {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
  }
  .back-btn {
    width: 52px;
    height: 52px;
    border-radius: 16px;
    background: #F2E8DA;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
  }
  .back-btn svg { width: 28px; height: 28px; color: #2E2318; }

  /* ── 스크롤 영역 ── */
  .auth-scroll {
    flex: 1;
    overflow-y: auto;
    padding: 0 30px 38px 30px;
    box-sizing: border-box;
  }

  /* ── 히어로 ── */
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 6px;
    padding-bottom: 24px;
  }
  .hero-icon {
    width: 64px;
    height: 64px;
    border-radius: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 14px;
  }
  .hero-icon svg { width: 34px; height: 34px; }
  .hero-title {
    font-weight: 800;
    font-size: 26px;
    letter-spacing: -0.5px;
    color: #2E2318;
    margin: 0;
  }
  .hero-sub {
    font-weight: 400;
    font-size: 15px;
    color: #7C6A54;
    margin-top: 6px;
    margin-bottom: 0;
  }

  /* ── 모드 토글 (가입 / 로그인) ── */
  .segment {
    display: flex;
    flex-direction: row;
    gap: 5px;
    padding: 5px;
    border-radius: 16px;
    background: #F2E8DA;
    margin-bottom: 24px;
  }
  .seg-btn {
    flex: 1;
    height: 46px;
    border-radius: 13px;
    border: none;
    background: transparent;
    font-family: 'Noto Sans KR', sans-serif;
    font-weight: 700;
    font-size: 15px;
    color: #8C7961;
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
  }
  .seg-btn.active {
    background: #FFFFFF;
    color: #2E2318;
  }

  /* ── 입력 필드 ── */
  .field { margin-bottom: 16px; }
  .field-label {
    font-weight: 700;
    font-size: 13px;
    color: #8C7961;
    letter-spacing: 0.3px;
    margin: 0 0 8px 2px;
  }
  .input {
    width: 100%;
    min-height: 56px;
    padding: 14px 18px;
    border-radius: 16px;
    border: 1.5px solid #E9DBC9;
    background: #FFFFFF;
    font-family: 'Noto Sans KR', sans-serif;
    font-weight: 500;
    font-size: 17px;
    color: #2E2318;
    box-sizing: border-box;
    outline: none;
    transition: border-color 0.15s;
  }
  .input:focus { border-color: #AC5D3B; }
  .input::placeholder { color: #B5A48A; font-weight: 400; }

  /* ── 가족 선택 (가입 모드) ── */
  .fam-label {
    font-weight: 700;
    font-size: 13px;
    color: #8C7961;
    letter-spacing: 0.3px;
    margin: 8px 0 10px 2px;
  }
  .fam-opt {
    border-radius: 16px;
    border: 1.5px solid #E9DBC9;
    background: #FFFFFF;
    padding: 16px;
    margin-bottom: 12px;
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s;
  }
  .fam-opt.active {
    border-color: #AC5D3B;
    background: #F4EAE6;
  }
  .fam-opt-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 12px;
  }
  .fam-opt-row svg { width: 24px; height: 24px; flex-shrink: 0; }
  .fam-opt-texts { flex: 1; }
  .fam-opt-title {
    font-weight: 700;
    font-size: 17px;
    color: #2E2318;
    margin: 0;
  }
  .fam-opt-sub {
    font-weight: 400;
    font-size: 13px;
    color: #8C7961;
    margin: 2px 0 0 0;
  }
  .fam-input {
    margin-top: 12px;
  }
  .code-input {
    font-weight: 700;
    letter-spacing: 1.5px;
  }

  /* ── 에러 박스 ── */
  .error-box {
    background: rgba(194,69,59,0.08);
    border-radius: 14px;
    padding: 13px 16px;
    margin: 4px 0;
  }
  .error-text {
    font-weight: 700;
    font-size: 15px;
    line-height: 22px;
    color: #C2453B;
    text-align: center;
    margin: 0;
  }

  /* ── 제출 버튼 ── */
  .submit-wrap {
    margin-top: 14px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .btn-primary {
    width: 100%;
    height: {{ is_parent ? '64px' : '56px' }};
    border-radius: {{ is_parent ? '18px' : '16px' }};
    border: none;
    background: #AC5D3B;
    color: #FFFFFF;
    font-family: 'Noto Sans KR', sans-serif;
    font-weight: 800;
    font-size: {{ is_parent ? '19px' : '17px' }};
    cursor: pointer;
    transition: opacity 0.15s;
    {% if is_parent %}
    box-shadow: 0 12px 20px rgba(172,93,59,0.5);
    {% endif %}
  }
  .btn-primary:hover { opacity: 0.9; }
  .btn-primary:active { opacity: 0.85; }
  .btn-primary:disabled {
    background: #E0D2BF;
    color: #B5A48A;
    cursor: not-allowed;
    box-shadow: none;
  }
  .btn-secondary {
    width: 100%;
    height: 56px;
    border-radius: 16px;
    border: 1.5px solid #E9DBC9;
    background: #FFFFFF;
    color: #2E2318;
    font-family: 'Noto Sans KR', sans-serif;
    font-weight: 700;
    font-size: 16px;
    cursor: pointer;
  }

  /* ── 초대코드 모달 ── */
  .modal-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(38,29,20,0.55);
    align-items: center;
    justify-content: center;
    z-index: 100;
  }
  .modal-overlay.show {
    display: flex;
  }
  .modal-body {
    background: #FFFFFF;
    border-radius: 26px;
    padding: 32px 28px;
    width: calc(390px - 56px);
    max-width: calc(100% - 56px);
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .modal-icon {
    width: 64px;
    height: 64px;
    border-radius: 32px;
    background: #F4EAE6;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
  }
  .modal-icon svg { width: 34px; height: 34px; color: #AC5D3B; }
  .modal-title {
    font-weight: 800;
    font-size: 22px;
    color: #2E2318;
    margin: 0 0 16px 0;
  }
  .modal-caption {
    font-weight: 700;
    font-size: 13px;
    color: #8C7961;
    margin: 0 0 8px 0;
  }
  .code-box {
    background: #F2E8DA;
    border-radius: 14px;
    padding: 16px 24px;
    margin-bottom: 12px;
  }
  .code-text {
    font-weight: 800;
    font-size: 24px;
    letter-spacing: 2px;
    color: #2E2318;
    margin: 0;
  }
  .modal-sub {
    font-weight: 400;
    font-size: 14px;
    color: #7C6A54;
    text-align: center;
    line-height: 22px;
    margin: 0 0 20px 0;
  }

  /* ── 토스트 ── */
  .toast {
    display: none;
    position: fixed;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    background: #2E2318;
    color: #FFFFFF;
    padding: 14px 22px;
    border-radius: 14px;
    font-weight: 700;
    font-size: 15px;
    z-index: 200;
    box-shadow: 0 16px 24px rgba(0,0,0,0.5);
  }
  .toast.show { display: block; }
</style>
{% endblock %}

{% block content %}
<div class="auth-root">
  {# ── 헤더 ── #}
  <div class="auth-header">
    <button class="back-btn" onclick="history.back()" aria-label="뒤로">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M19 12H5"/>
        <path d="M12 19l-7-7 7-7"/>
      </svg>
    </button>
  </div>

  {# ── 스크롤 영역 ── #}
  <div class="auth-scroll">
    {# 히어로 #}
    <div class="hero">
      <div class="hero-icon" style="background: {{ is_parent ? '#F4EAE6' : '#ECEAE4' }};">
        {% if is_parent %}
        <svg viewBox="0 0 24 24" fill="none" stroke="#AC5D3B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="5" r="2.5" fill="#AC5D3B" stroke="none"/>
          <path d="M12 8v6"/>
          <path d="M9 14l-1 4"/>
          <path d="M15 14l1 4"/>
          <path d="M9 11h6"/>
          <path d="M7 21l2-7"/>
          <path d="M17 21l-2-7"/>
        </svg>
        {% else %}
        <svg viewBox="0 0 24 24" fill="none" stroke="#5B7086" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="8" cy="6" r="2" fill="#5B7086" stroke="none"/>
          <circle cx="16" cy="6" r="2" fill="#5B7086" stroke="none"/>
          <circle cx="12" cy="14" r="2" fill="#5B7086" stroke="none"/>
          <path d="M8 8v2c0 2 2 3 4 3s4-1 4-3V8"/>
          <path d="M12 17v3"/>
          <path d="M9 21h6"/>
        </svg>
        {% endif %}
      </div>
      <h2 class="hero-title">{{ is_parent ? '부모님으로 시작해요' : '자녀로 시작해요' }}</h2>
      <p class="hero-sub">{{ is_parent ? '받은 질문에 목소리로 답해요' : '질문을 보내고 이야기를 모아요' }}</p>
    </div>

    {# 모드 토글 #}
    <div class="segment">
      <button class="seg-btn active" id="seg-signup" onclick="switchMode('signup')">처음 시작해요</button>
      <button class="seg-btn" id="seg-login" onclick="switchMode('login')">이미 계정이 있어요</button>
    </div>

    {# 가입 폼 #}
    <div id="signup-form">
      <div class="field">
        <p class="field-label">이름</p>
        <input class="input" id="su-name" type="text" placeholder="{{ is_parent ? '예: 김순자' : '예: 지훈' }}" />
      </div>
      <div class="field">
        <p class="field-label">아이디</p>
        <input class="input" id="su-username" type="text" placeholder="로그인에 사용할 아이디" autocomplete="off" />
      </div>
      <div class="field">
        <p class="field-label">비밀번호</p>
        <input class="input" id="su-password" type="password" placeholder="비밀번호" />
      </div>

      <p class="fam-label">가족</p>

      <div class="fam-opt active" id="fam-create" onclick="switchFam('create')">
        <div class="fam-opt-row">
          <svg viewBox="0 0 24 24" fill="#AC5D3B" stroke="none"><circle cx="12" cy="12" r="10"/></svg>
          <svg viewBox="0 0 24 24" fill="none" stroke="#AC5D3B" stroke-width="2" style="display:none;" id="fam-create-unchecked"><circle cx="12" cy="12" r="10"/></svg>
          <div class="fam-opt-texts">
            <p class="fam-opt-title">새 가족 만들기</p>
            <p class="fam-opt-sub">우리 가족의 첫 이야기 공간을 만들어요</p>
          </div>
        </div>
        <input class="input fam-input" id="su-family-name" type="text" placeholder="가족 이름 (예: 김순자네 가족)" />
      </div>

      <div class="fam-opt" id="fam-join" onclick="switchFam('join')">
        <div class="fam-opt-row">
          <svg viewBox="0 0 24 24" fill="none" stroke="#D1C0A6" stroke-width="2" id="fam-join-unchecked"><circle cx="12" cy="12" r="10"/></svg>
          <svg viewBox="0 0 24 24" fill="#AC5D3B" stroke="none" style="display:none;" id="fam-join-checked"><circle cx="12" cy="12" r="10"/></svg>
          <div class="fam-opt-texts">
            <p class="fam-opt-title">초대 코드로 참여</p>
            <p class="fam-opt-sub">가족이 알려준 코드로 함께해요</p>
          </div>
        </div>
        <input class="input fam-input code-input" id="su-invite-code" type="text" placeholder="초대 코드 (예: 3F9A21BC)" style="display:none;" autocomplete="off" />
      </div>
    </div>

    {# 로그인 폼 #}
    <div id="login-form" style="display:none;">
      <div class="field">
        <p class="field-label">아이디</p>
        <input class="input" id="li-username" type="text" placeholder="아이디" autocomplete="off" />
      </div>
      <div class="field">
        <p class="field-label">비밀번호</p>
        <input class="input" id="li-password" type="password" placeholder="비밀번호" />
      </div>
    </div>

    {# 에러 박스 #}
    <div class="error-box" id="error-box" style="display:none;">
      <p class="error-text" id="error-text"></p>
    </div>

    {# 제출 버튼 #}
    <div class="submit-wrap">
      <button class="btn-primary" id="submit-btn" onclick="submit()">이음 시작하기</button>
      <button class="btn-secondary" id="offline-btn" style="display:none;" onclick="continueOffline()">오프라인으로 계속하기</button>
    </div>
  </div>
</div>

{# 초대코드 모달 #}
<div class="modal-overlay" id="modal-overlay">
  <div class="modal-body">
    <div class="modal-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
        <path d="M22 4L12 14.01l-3-3"/>
      </svg>
    </div>
    <h3 class="modal-title">가족 공간이 만들어졌어요</h3>
    <p class="modal-caption">가족 초대 코드</p>
    <div class="code-box">
      <p class="code-text" id="modal-code"></p>
    </div>
    <p class="modal-sub">가족에게 이 코드를 공유하면<br />함께 이야기를 모을 수 있어요</p>
    <button class="btn-primary" onclick="enterFromModal()">이음 시작하기</button>
  </div>
</div>

{# 토스트 #}
<div class="toast" id="toast"></div>

<script>
  var role = "{{ role }}";
  var isParent = {{ is_parent ? 'true' : 'false' }};
  var mode = 'signup';
  var famMode = 'create';
  var loading = false;
  var pendingAuth = null;

  function switchMode(m) {
    if (m === mode) return;
    mode = m;
    document.getElementById('seg-signup').classList.toggle('active', m === 'signup');
    document.getElementById('seg-login').classList.toggle('active', m === 'login');
    document.getElementById('signup-form').style.display = m === 'signup' ? 'block' : 'none';
    document.getElementById('login-form').style.display = m === 'login' ? 'block' : 'none';
    hideError();
    document.getElementById('submit-btn').textContent = m === 'signup' ? '이음 시작하기' : '로그인';
  }

  function switchFam(f) {
    famMode = f;
    var create = document.getElementById('fam-create');
    var join = document.getElementById('fam-join');
    create.classList.toggle('active', f === 'create');
    join.classList.toggle('active', f === 'join');
    document.getElementById('su-family-name').style.display = f === 'create' ? 'block' : 'none';
    document.getElementById('su-invite-code').style.display = f === 'join' ? 'block' : 'none';
  }

  function showError(msg) {
    document.getElementById('error-text').textContent = msg;
    document.getElementById('error-box').style.display = 'block';
  }
  function hideError() {
    document.getElementById('error-box').style.display = 'none';
  }

  function showToast(msg) {
    var t = document.getElementById('toast');
    t.textContent = msg;
    t.classList.add('show');
    setTimeout(function() { t.classList.remove('show'); }, 2500);
  }

  async function submit() {
    if (loading) return;
    hideError();

    if (mode === 'signup') {
      var name = document.getElementById('su-name').value.trim();
      var username = document.getElementById('su-username').value.trim();
      var password = document.getElementById('su-password').value;
      var familyName = document.getElementById('su-family-name').value.trim();
      var inviteCode = document.getElementById('su-invite-code').value.trim().toUpperCase();

      if (!name) return showError('이름을 입력해 주세요');
      if (!username) return showError('아이디를 입력해 주세요');
      if (!password) return showError('비밀번호를 입력해 주세요');
      if (famMode === 'create' && !familyName) return showError('가족 이름을 입력해 주세요');
      if (famMode === 'join' && !inviteCode) return showError('초대 코드를 입력해 주세요');

      loading = true;
      document.getElementById('submit-btn').disabled = true;
      document.getElementById('submit-btn').textContent = '가입하는 중…';

      try {
        // 1. 가족 생성 또는 참여
        var famRes, familyId;
        if (famMode === 'create') {
          famRes = await fetch('/api/families', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name: familyName })
          });
          if (!famRes.ok) throw { status: famRes.status };
          var fam = await famRes.json();
          familyId = fam.id;
          var inviteCodeFromServer = fam.invite_code;
        } else {
          famRes = await fetch('/api/families/join?invite_code=' + encodeURIComponent(inviteCode), {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
          });
          if (!famRes.ok) throw { status: famRes.status };
          var famJoin = await famRes.json();
          familyId = famJoin.id;
        }

        // 2. 멤버 생성
        var memRes = await fetch('/api/members', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            family_id: familyId,
            name: name,
            role: role,
            username: username,
            password: password
          })
        });
        if (!memRes.ok) {
          var errBody = await memRes.json().catch(function() { return {}; });
          if (memRes.status === 409) throw { status: 409, msg: '아이디가 이미 사용 중이에요' };
          throw { status: memRes.status, msg: errBody.detail || '요청을 처리하지 못했어요' };
        }
        var member = await memRes.json();

        // 3. 자동 로그인
        var loginRes = await fetch('/api/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username: username, password: password })
        });
        if (!loginRes.ok) throw { status: loginRes.status };
        var auth = await loginRes.json();

        if (famMode === 'create' && auth.invite_code) {
          pendingAuth = auth;
          document.getElementById('modal-code').textContent = auth.invite_code;
          document.getElementById('modal-overlay').classList.add('show');
        } else {
          showToast(member.name + '님, 가족과 연결되었어요');
          sessionStorage.setItem('eum_auth', JSON.stringify(auth));
          setTimeout(function() { window.location.href = '/app'; }, 800);
        }
      } catch (e) {
        if (e && e.status === null) {
          showError('서버에 연결할 수 없어요 — 오프라인으로 계속할 수 있어요');
          document.getElementById('offline-btn').style.display = 'block';
        } else if (e && e.status === 409) {
          showError(e.msg || '아이디가 이미 사용 중이에요');
        } else if (e && e.status === 404) {
          showError('초대 코드를 찾을 수 없어요');
        } else if (e && e.status === 401) {
          showError('아이디 또는 비밀번호가 맞지 않아요');
        } else {
          showError((e && e.msg) || '요청을 처리하지 못했어요 — 잠시 후 다시 시도해 주세요');
        }
      } finally {
        loading = false;
        document.getElementById('submit-btn').disabled = false;
        document.getElementById('submit-btn').textContent = mode === 'signup' ? '이음 시작하기' : '로그인';
      }
    } else {
      // 로그인
      var liUsername = document.getElementById('li-username').value.trim();
      var liPassword = document.getElementById('li-password').value;

      if (!liUsername) return showError('아이디를 입력해 주세요');
      if (!liPassword) return showError('비밀번호를 입력해 주세요');

      loading = true;
      document.getElementById('submit-btn').disabled = true;
      document.getElementById('submit-btn').textContent = '로그인하는 중…';

      try {
        var res = await fetch('/api/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username: liUsername, password: liPassword })
        });
        if (!res.ok) {
          if (res.status === 401) throw { status: 401, msg: '아이디 또는 비밀번호가 맞지 않아요' };
          throw { status: res.status };
        }
        var auth = await res.json();
        showToast('다시 만나 반가워요, ' + auth.member.name + '님');
        sessionStorage.setItem('eum_auth', JSON.stringify(auth));
        setTimeout(function() { window.location.href = '/app'; }, 800);
      } catch (e) {
        if (e && e.status === null) {
          showError('서버에 연결할 수 없어요 — 오프라인으로 계속할 수 있어요');
          document.getElementById('offline-btn').style.display = 'block';
        } else {
          showError((e && e.msg) || '아이디 또는 비밀번호가 맞지 않아요');
        }
      } finally {
        loading = false;
        document.getElementById('submit-btn').disabled = false;
        document.getElementById('submit-btn').textContent = mode === 'signup' ? '이음 시작하기' : '로그인';
      }
    }
  }

  function continueOffline() {
    showToast('오프라인으로 시작해요 — 예시 데이터가 보여요');
    setTimeout(function() { window.location.href = '/app'; }, 800);
  }

  function enterFromModal() {
    if (!pendingAuth) return;
    showToast(pendingAuth.member.name + '님, 환영해요');
    sessionStorage.setItem('eum_auth', JSON.stringify(pendingAuth));
    document.getElementById('modal-overlay').classList.remove('show');
    setTimeout(function() { window.location.href = '/app'; }, 800);
  }
</script>
{% endblock %}
