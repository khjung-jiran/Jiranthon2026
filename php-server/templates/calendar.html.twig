{% extends 'base.html.twig' %}

{% block title %}이음 · 캘린더{% endblock %}

{% block content %}
<main class="app app--status{% if is_parent %} app--parent{% endif %}">
  <div class="cal">

    <header class="cal__head">
      <div>
        <div class="cal__kicker">우리 가족의 날들</div>
        <h1 class="cal__title" id="calTitle"></h1>
      </div>
    </header>

    <div class="cal__grid-wrap">
      <div class="cal__grid" id="calGrid">
        <!-- JS로 달력 생성 -->
      </div>
    </div>

    <section class="cal__events">
      <div class="cal__events-head">
        <span class="sec-title">다가오는 일정</span>
        <button type="button" class="cal__add" onclick="openAddModal()">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#C05430" stroke-width="2.4" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
          일정 추가
        </button>
      </div>
      <div class="cal__list" id="calList">
      </div>
    </section>

  </div>

  <!-- 일정 추가 모달 -->
  <div id="addModal" style="display:none;position:fixed;inset:0;z-index:100;background:rgba(0,0,0,.4);align-items:center;justify-content:center;">
    <div style="width:340px;background:#fff;border-radius:20px;padding:24px 22px;box-shadow:0 20px 50px rgba(0,0,0,.2);">
      <div style="font-size:18px;font-weight:700;margin-bottom:18px;">일정 추가</div>

      <div style="display:flex;flex-direction:column;gap:14px;">
        <div>
          <div style="font-size:12.5px;font-weight:700;color:#5C544A;margin-bottom:6px;">날짜</div>
          <input class="input" type="date" id="entryDate" style="width:100%;">
        </div>
        <div>
          <div style="font-size:12.5px;font-weight:700;color:#5C544A;margin-bottom:6px;">제목</div>
          <input class="input" type="text" id="entryTitle" placeholder="예: 아버지 생신" style="width:100%;">
        </div>
        <div>
          <div style="font-size:12.5px;font-weight:700;color:#5C544A;margin-bottom:6px;">태그 <span style="font-weight:400;color:#B4A99C;">(선택)</span></div>
          <input class="input" type="text" id="entryTag" placeholder="예: 가족 기념일" style="width:100%;">
        </div>
      </div>

      <div style="display:flex;gap:10px;margin-top:22px;">
        <button type="button" class="btn btn--ghost" style="flex:1;" onclick="closeAddModal()">
          <span class="btn__label">취소</span>
        </button>
        <button type="button" class="btn btn--primary" style="flex:1;" id="saveEntryBtn" onclick="saveEntry()">
          <span class="btn__label">추가</span>
        </button>
      </div>
    </div>
  </div>

  <!-- 하단 탭바 (캘린더 활성) -->
  <nav class="tabbar{% if is_parent %} tabbar--parent{% endif %}">
    <a class="tabbar__item" href="/story-child">
      <svg width="{% if is_parent %}26{% else %}21{% endif %}" height="{% if is_parent %}26{% else %}21{% endif %}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
      <span class="tabbar__label">이야기</span>
    </a>
    <a class="tabbar__item" href="/album">
      <svg width="{% if is_parent %}26{% else %}21{% endif %}" height="{% if is_parent %}26{% else %}21{% endif %}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
      <span class="tabbar__label">앨범</span>
    </a>
    <a class="tabbar__item" href="/home">
      {% if is_parent %}
      <span class="tabbar__home tabbar__home--off">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h5v-6h4v6h5V9.5"/></svg>
      </span>
      {% else %}
      <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h5v-6h4v6h5V9.5"/></svg>
      {% endif %}
      <span class="tabbar__label">홈</span>
    </a>
    <a class="tabbar__item tabbar__item--on" href="/calendar">
      <svg width="{% if is_parent %}26{% else %}21{% endif %}" height="{% if is_parent %}26{% else %}21{% endif %}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 10h18M8 2v4M16 2v4"/></svg>
      <span class="tabbar__label tabbar__label--on">캘린더</span>
    </a>
    <a class="tabbar__item" href="/settings">
      <svg width="{% if is_parent %}26{% else %}21{% endif %}" height="{% if is_parent %}26{% else %}21{% endif %}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6"/></svg>
      <span class="tabbar__label">설정</span>
    </a>
  </nav>

</main>
{% endblock %}

{% block scripts %}
<script>
  var authData = null;
  var calYear = 0, calMonth = 0;
  var entries = [];

  (function init() {
    var auth = localStorage.getItem('eum_auth') || sessionStorage.getItem('eum_auth');
    if (!auth) { window.location.href = '/login'; return; }
    try { authData = JSON.parse(auth); } catch (e) {}

    var now = new Date();
    calYear = now.getFullYear();
    calMonth = now.getMonth();

    renderCalendar();
    loadEntries();
  })();

  function renderCalendar() {
    document.getElementById('calTitle').textContent = calYear + '년 ' + (calMonth+1) + '월';

    var firstDay = new Date(calYear, calMonth, 1).getDay();
    var daysInMonth = new Date(calYear, calMonth+1, 0).getDate();
    var today = new Date();
    var isCurrentMonth = today.getFullYear() === calYear && today.getMonth() === calMonth;
    var dows = ['일','월','화','수','목','금','토'];
    var html = '';

    dows.forEach(function(d, i) {
      html += '<div class="cal__dow' + (i === 0 ? ' cal__dow--sun' : '') + '">' + d + '</div>';
    });

    for (var i = 0; i < firstDay; i++) {
      html += '<div class="cal__day"></div>';
    }

    for (var d = 1; d <= daysInMonth; d++) {
      var classes = 'cal__day';
      var dayOfWeek = new Date(calYear, calMonth, d).getDay();
      if (dayOfWeek === 0) classes += ' cal__day--sun';
      if (isCurrentMonth && d === today.getDate()) classes += ' cal__day--today';

      // 일정 있는 날에 점 표시
      var dateStr = calYear + '-' + String(calMonth+1).padStart(2,'0') + '-' + String(d).padStart(2,'0');
      var hasEntry = entries.some(function(e) { return e.date === dateStr; });
      if (hasEntry) classes += '';
      html += '<div class="' + classes + '">' + d;
      if (hasEntry) html += '<span class="cal__day-dot"></span>';
      html += '</div>';
    }

    document.getElementById('calGrid').innerHTML = html;
  }

  async function loadEntries() {
    if (!authData || !authData.family) return;
    var familyId = authData.family.id;

    try {
      var res = await fetch('/api/calendar/entries?family_id=' + encodeURIComponent(familyId) + '&upcoming=true');
      if (!res.ok) return;
      entries = await res.json();
      renderCalendar();
      renderEntryList();
    } catch (e) {}
  }

  function renderEntryList() {
    var list = document.getElementById('calList');
    if (entries.length === 0) {
      list.innerHTML = '<div style="text-align:center;color:#B4A99C;font-size:13px;padding:24px 0;">다가오는 일정이 없어요</div>';
      return;
    }

    var html = '';
    var today = new Date();
    today.setHours(0,0,0,0);

    entries.forEach(function(e) {
      var entryDate = new Date(e.date);
      var diff = Math.ceil((entryDate - today) / (1000*60*60*24));
      var mo = entryDate.getMonth() + 1;
      var day = entryDate.getDate();

      var isWarm = e.tag && e.tag.indexOf('기념') >= 0;
      var dateClass = isWarm ? 'event__date event__date--warm' : 'event__date';
      var isOwner = authData && authData.member && e.created_by === authData.member.id;

      html += '<article class="event">';
      html += '<div class="' + dateClass + '">';
      html += '<span class="event__mo">' + mo + '월</span>';
      html += '<span class="event__day">' + day + '</span>';
      html += '</div>';
      html += '<div class="event__body">';
      html += '<div class="event__title">' + escapeHtml(e.title) + '</div>';
      if (e.tag) {
        html += '<div class="event__sub">' + escapeHtml(e.tag) + '</div>';
      }
      html += '</div>';
      if (diff > 0) {
        html += '<span class="pill pill--dday">D-' + diff + '</span>';
      } else if (diff === 0) {
        html += '<span class="pill pill--dday">오늘</span>';
      }
      if (isOwner) {
        html += '<button type="button" onclick="deleteEntry(\'' + e.id + '\',\'' + escapeHtml(e.title).replace(/'/g,"\\'") + '\')" style="flex-shrink:0;width:28px;height:28px;border:none;background:transparent;cursor:pointer;display:flex;align-items:center;justify-content:center;color:#B4A99C;margin-left:4px;">';
        html += '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2m3 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M10 11v6M14 11v6"/></svg>';
        html += '</button>';
      }
      html += '</article>';
    });

    list.innerHTML = html;
  }

  function openAddModal() {
    var today = new Date();
    var dateStr = today.getFullYear() + '-' + String(today.getMonth()+1).padStart(2,'0') + '-' + String(today.getDate()).padStart(2,'0');
    document.getElementById('entryDate').value = dateStr;
    document.getElementById('entryTitle').value = '';
    document.getElementById('entryTag').value = '';
    var modal = document.getElementById('addModal');
    modal.style.display = 'flex';
  }

  function closeAddModal() {
    document.getElementById('addModal').style.display = 'none';
  }

  async function saveEntry() {
    var date = document.getElementById('entryDate').value;
    var title = document.getElementById('entryTitle').value.trim();
    var tag = document.getElementById('entryTag').value.trim();
    var btn = document.getElementById('saveEntryBtn');

    if (!date) { alert('날짜를 선택해 주세요'); return; }
    if (!title) { alert('제목을 입력해 주세요'); return; }

    if (!authData || !authData.family || !authData.member) {
      alert('로그인 정보가 없어요');
      return;
    }

    btn.disabled = true;
    btn.querySelector('.btn__label').textContent = '추가 중…';

    try {
      var res = await fetch('/api/calendar/entries', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          family_id: authData.family.id,
          created_by: authData.member.id,
          date: date,
          title: title,
          tag: tag || null
        })
      });

      if (!res.ok) {
        alert('일정 추가에 실패했어요');
        return;
      }

      closeAddModal();
      await loadEntries();
    } catch (e) {
      alert('서버에 연결할 수 없어요');
    } finally {
      btn.disabled = false;
      btn.querySelector('.btn__label').textContent = '추가';
    }
  }

  async function deleteEntry(id, title) {
    if (!confirm('"' + title + '" 일정을 삭제할까요?')) return;

    try {
      var memberId = authData && authData.member ? authData.member.id : '';
      var res = await fetch('/api/calendar/entries/' + encodeURIComponent(id) + '?member_id=' + encodeURIComponent(memberId), {
        method: 'DELETE'
      });
      if (!res.ok) {
        alert('삭제에 실패했어요');
        return;
      }
      await loadEntries();
    } catch (e) {
      alert('서버에 연결할 수 없어요');
    }
  }

  function escapeHtml(s) {
    var div = document.createElement('div');
    div.textContent = s;
    return div.innerHTML;
  }
</script>
{% endblock %}
