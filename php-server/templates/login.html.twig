{% extends 'base.html.twig' %}

{% block title %}이음 · 로그인{% endblock %}

{% block content %}
<!-- 화면: 로그인 / 진입점: 앱 최초 실행 -->
<main class="app login">

  <div class="login__brand">
    <h1 class="login__logo">이음</h1>
    <p class="login__tagline">묻고 답하며 가족의 이야기를<br>한 권의 책으로 모아요</p>
  </div>

  <!-- 아이디 / 비밀번호 -->
  <form class="login__fields" id="login-form" onsubmit="return false;">
    <input class="input" type="text" id="userId" name="userId" placeholder="아이디" autocomplete="username">
    <input class="input" type="password" id="password" name="password" placeholder="비밀번호" autocomplete="current-password">
  </form>

  <div class="login__row">
    <label class="check" onclick="toggleAutoLogin()">
      <span class="check__box" id="autoLoginBox">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
      </span>
      <span class="check__label">자동 로그인</span>
    </label>
    <a class="login__find" href="#">아이디 · 비밀번호 찾기</a>
  </div>

  <button type="submit" class="btn btn--primary login__submit" id="loginBtn" onclick="doLogin()">
    <span class="btn__label">로그인</span>
  </button>

  <div class="divider-row">
    <span class="divider-row__line"></span>
    <span class="divider-row__text">간편 로그인</span>
    <span class="divider-row__line"></span>
  </div>

  <div class="login__social">
    <button type="button" class="btn btn--social" onclick="socialLogin('google')">
      <svg width="19" height="19" viewBox="0 0 48 48"><path fill="#4285F4" d="M45.12 24.5c0-1.56-.14-3.06-.4-4.5H24v8.51h11.84c-.51 2.75-2.06 5.08-4.39 6.64v5.52h7.11c4.16-3.83 6.56-9.47 6.56-16.17z"/><path fill="#34A853" d="M24 46c5.94 0 10.92-1.97 14.56-5.33l-7.11-5.52c-1.97 1.32-4.49 2.1-7.45 2.1-5.73 0-10.58-3.87-12.31-9.07H4.34v5.7C7.96 41.07 15.4 46 24 46z"/><path fill="#FBBC05" d="M11.69 28.18C11.25 26.86 11 25.45 11 24s.25-2.86.69-4.18v-5.7H4.34C2.85 17.09 2 20.45 2 24s.85 6.91 2.34 9.88l7.35-5.7z"/><path fill="#EA4335" d="M24 10.75c3.23 0 6.13 1.11 8.41 3.29l6.31-6.31C34.91 4.18 29.93 2 24 2 15.4 2 7.96 6.93 4.34 14.12l7.35 5.7c1.73-5.2 6.58-9.07 12.31-9.07z"/></svg>
      <span class="btn__label">구글로 계속하기</span>
    </button>
    <button type="button" class="btn btn--kakao" onclick="socialLogin('kakao')">
      <svg width="19" height="19" viewBox="0 0 24 24" fill="#191600"><path d="M12 3C6.5 3 2 6.48 2 10.77c0 2.76 1.87 5.18 4.68 6.55-.2.72-.74 2.68-.85 3.1-.13.52.19.51.4.37.17-.11 2.66-1.8 3.74-2.53.66.1 1.34.15 2.03.15 5.52 0 10-3.48 10-7.64S17.52 3 12 3z"/></svg>
      <span class="btn__label">카카오로 계속하기</span>
    </button>
  </div>

  <div class="login__foot">
    <span class="login__foot-text">처음이신가요?</span>
    <a class="login__foot-link" href="/signup">회원가입</a>
  </div>

</main>
{% endblock %}

{% block scripts %}
<script>
  var autoLogin = true;

  function toggleAutoLogin() {
    autoLogin = !autoLogin;
    var box = document.getElementById('autoLoginBox');
    if (autoLogin) {
      box.classList.remove('check__box--off');
    } else {
      box.classList.add('check__box--off');
    }
  }

  async function doLogin() {
    var userId = document.getElementById('userId').value.trim();
    var password = document.getElementById('password').value;
    var btn = document.getElementById('loginBtn');

    if (!userId) { alert('아이디를 입력해 주세요'); return; }
    if (!password) { alert('비밀번호를 입력해 주세요'); return; }

    btn.disabled = true;
    btn.querySelector('.btn__label').textContent = '로그인 중…';

    try {
      var res = await fetch('/api/auth/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ username: userId, password: password })
      });

      if (!res.ok) {
        var err = await res.json().catch(function() { return {}; });
        alert(err.detail || '아이디 또는 비밀번호가 맞지 않아요');
        return;
      }

      var auth = await res.json();

      // 자동 로그인이면 localStorage, 아니면 sessionStorage
      var storage = autoLogin ? localStorage : sessionStorage;
      storage.setItem('eum_auth', JSON.stringify(auth));

      // Android 네이티브에 FCM 토큰 등록 요청
      if (typeof AndroidBridge !== 'undefined' && AndroidBridge.registerFcmToken && auth.member && auth.member.id) {
        try { AndroidBridge.registerFcmToken(auth.member.id); } catch(e) { console.error('FCM bridge error:', e); }
      }

      // role 쿠키 설정 후 /home로 이동 (브릿지 호출 완료를 위해 약간 지연)
      var role = (auth.member && auth.member.role) || 'child';
      document.cookie = 'eum_role=' + role + ';path=/;max-age=2592000';
      setTimeout(function() { window.location.href = '/home'; }, 200);
    } catch (e) {
      alert('서버에 연결할 수 없어요');
    } finally {
      btn.disabled = false;
      btn.querySelector('.btn__label').textContent = '로그인';
    }
  }

  function socialLogin(provider) {
    if (provider === 'kakao') {
      // 서버가 카카오 인가 페이지로 리다이렉트하고, 콜백에서 로그인까지 마친다.
      window.location.href = '/auth/kakao';
      return;
    }
    alert('준비중입니다');
  }
</script>
{% endblock %}
