{% extends 'base.html.twig' %}

{% block title %}이음 · 회원가입{% endblock %}

{% block content %}
<!--
  화면: 회원가입 / 진입점: 로그인 화면 하단 "회원가입"
  ※ 이 화면은 원본 프로토타입에 없어, 동일한 디자인 시스템으로 신규 구성했습니다.
-->
<main class="app signup">

  <div class="signup__head page-head">
    <a class="icon-btn" href="/login" aria-label="뒤로">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#5C544A" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
    </a>
    <span class="page-head__title">회원가입</span>
  </div>

  <h1 class="signup__title">가족을 이어볼까요</h1>
  <p class="signup__desc">가입 후 가족 코드를 주고받으면<br>서로의 질문과 답변이 연결돼요.</p>

  <!-- 카카오 계정 안내 배너 (카카오 모드에서만 노출) -->
  <div id="kakaoBanner" class="field" style="display:none;">
    <p class="signup__desc" style="margin:0;color:#C05430;">
      카카오 계정으로 가입해요. 가입 후에는 카카오로 바로 로그인돼요.
    </p>
  </div>

  <!-- 역할 선택 -->
  <div class="field">
    <span class="field__label">어떤 역할로 사용하시나요?</span>
  </div>
  <div class="role-pick">
    <label class="role role--on" id="role-child" onclick="selectRole('child')">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#C05430" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      <span class="role__name">자녀</span>
      <span class="role__sub">질문을 보내고<br>이야기를 모아요</span>
    </label>
    <label class="role" id="role-parent" onclick="selectRole('parent')">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#5C544A" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2M12 19v4M8 23h8"/></svg>
      <span class="role__name">부모</span>
      <span class="role__sub">목소리로<br>답해요</span>
    </label>
  </div>

  <!-- 부모 세부 역할 선택 (부모 선택 시 노출) -->
  <div id="parentRolePick" style="display:none;">
    <div class="field">
      <span class="field__label">어머니인가요, 아버지인가요?</span>
    </div>
    <div class="role-pick">
      <label class="role role--on" id="subrole-mom" onclick="selectSubRole('mom')">
        <span class="role__name">어머니</span>
      </label>
      <label class="role" id="subrole-dad" onclick="selectSubRole('dad')">
        <span class="role__name">아버지</span>
      </label>
    </div>
  </div>

  <form action="#" method="post" onsubmit="return false;">
    <label class="field">
      <span class="field__label">이름</span>
      <input class="input" type="text" id="name" name="name" placeholder="지훈">
    </label>

    <div id="credentialFields">
      <label class="field">
        <span class="field__label">아이디</span>
        <input class="input" type="text" id="userId" name="userId" placeholder="영문 · 숫자 4~20자">
      </label>

      <label class="field">
        <span class="field__label">비밀번호</span>
        <input class="input" type="password" id="password" name="password" placeholder="8자 이상, 숫자 포함">
        <span class="field__help">영문 · 숫자를 섞어 8자 이상 입력해 주세요.</span>
      </label>

      <label class="field">
        <span class="field__label">비밀번호 확인</span>
        <input class="input" type="password" id="passwordConfirm" name="passwordConfirm" placeholder="한 번 더 입력해 주세요">
      </label>
    </div>

    <label class="field">
      <span class="field__label">가족 코드 <span class="field__help">(선택)</span></span>
      <input class="input" type="text" id="familyCode" name="familyCode" placeholder="예: EIUM-4821">
      <span class="field__help">나중에 설정에서도 연결할 수 있어요.</span>
    </label>

    <!-- 약관 동의 -->
    <div class="agree">
      <label class="agree__row" onclick="toggleCheck('agree-terms', event)">
        <span class="check__box" id="agree-terms">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
        </span>
        <span class="agree__text"><b>[필수]</b> 이용약관에 동의합니다</span>
      </label>
      <label class="agree__row" onclick="toggleCheck('agree-privacy', event)">
        <span class="check__box" id="agree-privacy">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
        </span>
        <span class="agree__text"><b>[필수]</b> 개인정보 처리방침에 동의합니다</span>
      </label>
      <label class="agree__row" onclick="toggleCheck('agree-notify', event)">
        <span class="check__box check__box--off" id="agree-notify">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
        </span>
        <span class="agree__text">[선택] 새 질문 · 이야기 완성 알림 받기</span>
      </label>
    </div>

    <button type="submit" class="btn btn--primary btn--block signup__submit" onclick="doSignup()">
      <span class="btn__label">가입하고 시작하기</span>
    </button>
  </form>

</main>
{% endblock %}

{% block scripts %}
<script>
  var selectedRole = 'child';
  var selectedSubRole = 'mom';

  // ── 카카오 최초 로그인 가입 모드 ──
  // 카카오 콜백이 localStorage 에 심어둔 pending 정보를 읽는다.
  var kakaoPending = null;
  try {
    kakaoPending = JSON.parse(localStorage.getItem('eum_kakao_pending') || 'null');
  } catch (e) { kakaoPending = null; }

  if (kakaoPending && kakaoPending.provider === 'kakao' && kakaoPending.provider_id) {
    // 카카오 모드: 안내 배너 노출, 아이디/비밀번호 필드 숨김, 닉네임 자동 채움
    document.getElementById('kakaoBanner').style.display = '';
    document.getElementById('credentialFields').style.display = 'none';
    if (kakaoPending.nickname) {
      document.getElementById('name').value = kakaoPending.nickname;
    }
  }

  function selectRole(role) {
    selectedRole = role;
    var child = document.getElementById('role-child');
    var parent = document.getElementById('role-parent');
    if (role === 'child') {
      child.classList.add('role--on');
      parent.classList.remove('role--on');
      child.querySelector('svg').setAttribute('stroke', '#C05430');
      parent.querySelector('svg').setAttribute('stroke', '#5C544A');
    } else {
      parent.classList.add('role--on');
      child.classList.remove('role--on');
      parent.querySelector('svg').setAttribute('stroke', '#C05430');
      child.querySelector('svg').setAttribute('stroke', '#5C544A');
    }
    document.getElementById('parentRolePick').style.display = role === 'parent' ? '' : 'none';
  }

  function selectSubRole(sub) {
    selectedSubRole = sub;
    var mom = document.getElementById('subrole-mom');
    var dad = document.getElementById('subrole-dad');
    if (sub === 'mom') {
      mom.classList.add('role--on');
      dad.classList.remove('role--on');
    } else {
      dad.classList.add('role--on');
      mom.classList.remove('role--on');
    }
  }

  function toggleCheck(id, event) {
    if (event) event.preventDefault();
    var box = document.getElementById(id);
    box.classList.toggle('check__box--off');
  }

  async function doSignup() {
    var name = document.getElementById('name').value.trim();
    var familyCode = document.getElementById('familyCode').value.trim();
    var agreeTerms = !document.getElementById('agree-terms').classList.contains('check__box--off');
    var agreePrivacy = !document.getElementById('agree-privacy').classList.contains('check__box--off');

    var isKakao = !!(kakaoPending && kakaoPending.provider === 'kakao' && kakaoPending.provider_id);

    var userId, password, passwordConfirm;
    if (!isKakao) {
      userId = document.getElementById('userId').value.trim();
      password = document.getElementById('password').value;
      passwordConfirm = document.getElementById('passwordConfirm').value;
    }

    if (!name) { alert('이름을 입력해 주세요'); return; }
    if (!isKakao) {
      if (!userId) { alert('아이디를 입력해 주세요'); return; }
      if (userId.length < 4 || userId.length > 20) { alert('아이디는 4~20자로 입력해 주세요'); return; }
      if (!password) { alert('비밀번호를 입력해 주세요'); return; }
      if (password.length < 8) { alert('비밀번호는 8자 이상 입력해 주세요'); return; }
      if (password !== passwordConfirm) { alert('비밀번호가 일치하지 않아요'); return; }
    }
    if (!agreeTerms) { alert('이용약관에 동의해 주세요'); return; }
    if (!agreePrivacy) { alert('개인정보 처리방침에 동의해 주세요'); return; }

    var btn = document.querySelector('.signup__submit');
    btn.disabled = true;
    btn.querySelector('.btn__label').textContent = '가입 중…';

    try {
      // 1. 가족 처리: 가족 코드가 있으면 참여, 없으면 새로 생성
      var familyId;
      var family;
      if (familyCode) {
        // 초대코드로 가족 찾기
        var joinRes = await fetch('/api/families/join?invite_code=' + encodeURIComponent(familyCode), {
          method: 'POST'
        });
        if (!joinRes.ok) {
          var joinErr = await joinRes.json().catch(function() { return {}; });
          alert(joinErr.detail || '가족 코드를 찾을 수 없어요');
          return;
        }
        family = await joinRes.json();
        familyId = family.id;
      } else {
        // 새 가족 생성
        var createRes = await fetch('/api/families', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name: name + ' 가족' })
        });
        if (!createRes.ok) {
          alert('가족 생성에 실패했어요');
          return;
        }
        family = await createRes.json();
        familyId = family.id;
      }

      // 2. 멤버 생성
      var memberPayload = {
        family_id: familyId,
        name: name,
        role: selectedRole,
        sub_role: selectedRole === 'parent' ? selectedSubRole : null
      };
      if (isKakao) {
        // 카카오 가입: 아이디/비밀번호 대신 provider 식별자를 저장
        memberPayload.provider = kakaoPending.provider;
        memberPayload.provider_id = kakaoPending.provider_id;
        if (kakaoPending.profile_image) {
          memberPayload.profile_image = kakaoPending.profile_image;
        }
      } else {
        memberPayload.username = userId;
        memberPayload.password = password;
      }

      var memberRes = await fetch('/api/members', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(memberPayload)
      });

      if (!memberRes.ok) {
        var memberErr = await memberRes.json().catch(function() { return {}; });
        if (memberRes.status === 409) {
          alert('이미 사용 중인 아이디입니다');
        } else {
          alert(memberErr.detail || '회원가입에 실패했어요');
        }
        return;
      }

      var member = await memberRes.json();

      if (isKakao) {
        // 카카오 가입: 즉시 로그인 처리해서 /home 으로 진입
        localStorage.removeItem('eum_kakao_pending');
        var auth = {
          member: member,
          family: family,
          invite_code: family.invite_code || null
        };
        localStorage.setItem('eum_auth', JSON.stringify(auth));
        if (typeof AndroidBridge !== 'undefined' && AndroidBridge.registerFcmToken && member && member.id) {
          try { AndroidBridge.registerFcmToken(member.id); } catch (e) { console.error('FCM bridge error:', e); }
        }
        var role = (member && member.role) || 'child';
        document.cookie = 'eum_role=' + role + ';path=/;max-age=2592000';
        window.location.href = '/home';
      } else {
        alert('가입이 완료되었어요! 로그인 페이지로 이동합니다.');
        window.location.href = '/login';
      }
    } catch (e) {
      alert('서버에 연결할 수 없어요');
    } finally {
      btn.disabled = false;
      btn.querySelector('.btn__label').textContent = '가입하고 시작하기';
    }
  }
</script>
{% endblock %}
